{
	"name": "chop",
	"version": "0.1.0",
	"description": "Ethereum Swiss Army knife - cast-compatible CLI, TUI, and MCP server",
	"type": "module",
	"license": "MIT",
	"bin": {
		"chop": "./dist/bin/chop.js"
	},
	"exports": {
		".": {
			"import": "./dist/src/index.js",
			"types": "./dist/src/index.d.ts"
		}
	},
	"files": [
		"dist/"
	],
	"scripts": {
		"build": "tsup",
		"dev": "bun run bin/chop.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check src/ bin/ test/",
		"lint:fix": "biome check --write src/ bin/ test/",
		"format": "biome format --write src/ bin/ test/",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/cli": "^0.73.0",
		"@effect/platform": "^0.94.0",
		"@effect/platform-node": "^0.104.0",
		"effect": "^3.19.0",
		"voltaire-effect": "^0.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@effect/vitest": "^0.27.0",
		"@vitest/coverage-v8": "^3.2.0",
		"tsup": "^8.4.0",
		"typescript": "^5.7.0",
		"vitest": "^3.2.0"
	},
	"engines": {
		"node": ">=22.0.0",
		"bun": ">=1.2.0"
	},
	"packageManager": "bun@1.2.0"
}
