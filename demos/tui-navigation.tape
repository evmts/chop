Source demos/theme.tape
Set Height 800
Output demos/tui-navigation.gif

# TUI Navigation
# Start the node and navigate through tabs

Sleep 500ms

Type "chop node"
Enter
Sleep 5s

# Switch between tabs using number keys
Type "2"
Sleep 2s

Type "3"
Sleep 2s

Type "4"
Sleep 2s

Type "1"
Sleep 2s

# Show help overlay
Type "?"
Sleep 3s

# Dismiss help and quit
Type "q"
Sleep 2s
